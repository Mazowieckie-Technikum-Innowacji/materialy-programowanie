<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Minimum i maksimum tablicy</Title>
      <Shortcut>tabm</Shortcut>
      <Description>Szukanie najmniejszej i najwiekszej wartosci</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>t</ID>
          <ToolTip>t</ToolTip>
          <Default>tab</Default>
        </Literal>
        <Literal>
          <ID>min</ID>
          <ToolTip>min</ToolTip>
          <Default>min</Default>
        </Literal>
        <Literal>
          <ID>max</ID>
          <ToolTip>max</ToolTip>
          <Default>max</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method body" Delimiter="$"><![CDATA[int $min$ = $t$[0];
int $max$ = $t$[0];
for (int i = 1; i < $t$.Length; i++)
{
    if ($t$[i] < $min$) $min$ = $t$[i];
    if ($t$[i] > $max$) $max$ = $t$[i];
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
