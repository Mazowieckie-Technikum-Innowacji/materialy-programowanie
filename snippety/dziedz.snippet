<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Klasa pochodna</Title>
      <Shortcut>dziedz</Shortcut>
      <Description>Dziedziczenie z wywolaniem konstruktora bazowego</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>Pochodna</ID>
          <ToolTip>Pochodna</ToolTip>
          <Default>Pochodna</Default>
        </Literal>
        <Literal>
          <ID>Bazowa</ID>
          <ToolTip>Bazowa</ToolTip>
          <Default>Bazowa</Default>
        </Literal>
        <Literal>
          <ID>typ</ID>
          <ToolTip>typ</ToolTip>
          <Default>int</Default>
        </Literal>
        <Literal>
          <ID>param</ID>
          <ToolTip>param</ToolTip>
          <Default>parametr</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="type decl" Delimiter="$"><![CDATA[public class $Pochodna$ : $Bazowa$
{
    public $Pochodna$($typ$ $param$) : base($param$)
    {
        $end$
    }
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
