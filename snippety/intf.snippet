<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Interfejs</Title>
      <Shortcut>intf</Shortcut>
      <Description>Deklaracja interfejsu</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>Nazwa</ID>
          <ToolTip>Nazwa</ToolTip>
          <Default>Nazwa</Default>
        </Literal>
        <Literal>
          <ID>typ</ID>
          <ToolTip>typ</ToolTip>
          <Default>void</Default>
        </Literal>
        <Literal>
          <ID>Metoda</ID>
          <ToolTip>Metoda</ToolTip>
          <Default>Wykonaj</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="type decl" Delimiter="$"><![CDATA[public interface I$Nazwa$
{
    $typ$ $Metoda$();
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
