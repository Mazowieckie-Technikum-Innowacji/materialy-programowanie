<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>ToString</Title>
      <Shortcut>tostr</Shortcut>
      <Description>Nadpisanie metody ToString</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>pola</ID>
          <ToolTip>pola</ToolTip>
          <Default>{pole}</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method decl" Delimiter="$"><![CDATA[public override string ToString()
{
    return $$"$pola$";
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
