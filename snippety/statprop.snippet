<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Wlasciwosc statyczna (licznik)</Title>
      <Shortcut>statprop</Shortcut>
      <Description>Licznik instancji z private set</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>typ</ID>
          <ToolTip>typ</ToolTip>
          <Default>int</Default>
        </Literal>
        <Literal>
          <ID>Nazwa</ID>
          <ToolTip>Nazwa</ToolTip>
          <Default>LiczbaInstancji</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method decl" Delimiter="$"><![CDATA[public static $typ$ $Nazwa$ { get; private set; }
// w konstruktorze dodaj: $Nazwa$++;]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
