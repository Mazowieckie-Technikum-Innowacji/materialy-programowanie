<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Zlicz rodzaje znakow</Title>
      <Shortcut>strkl</Shortcut>
      <Description>Litery, cyfry, wielkie i male litery w tekscie</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>nazwa</ID>
          <ToolTip>nazwa</ToolTip>
          <Default>ZliczRodzajeZnakow</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method decl" Delimiter="$"><![CDATA[public static void $nazwa$(string tekst)
{
    int litery = 0, cyfry = 0, wielkie = 0, male = 0;
    foreach (char c in tekst)
    {
        if (char.IsLetter(c)) litery++;
        if (char.IsDigit(c)) cyfry++;
        if (char.IsUpper(c)) wielkie++;
        if (char.IsLower(c)) male++;
    }
    Console.WriteLine($$"Litery: {litery}, cyfry: {cyfry}, wielkie: {wielkie}, male: {male}");
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
