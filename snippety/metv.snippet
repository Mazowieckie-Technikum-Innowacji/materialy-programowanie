<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Metoda void</Title>
      <Shortcut>metv</Shortcut>
      <Description>Statyczna metoda bez zwracania wartosci</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>nazwa</ID>
          <ToolTip>nazwa</ToolTip>
          <Default>NazwaMetody</Default>
        </Literal>
        <Literal>
          <ID>typ</ID>
          <ToolTip>typ</ToolTip>
          <Default>int</Default>
        </Literal>
        <Literal>
          <ID>param</ID>
          <ToolTip>param</ToolTip>
          <Default>parametr</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method decl" Delimiter="$"><![CDATA[public static void $nazwa$($typ$ $param$)
{
    $end$
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
