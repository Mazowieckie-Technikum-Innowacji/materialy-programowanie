<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Wczytaj liczbe calkowita</Title>
      <Shortcut>rdint</Shortcut>
      <Description>int.Parse(Console.ReadLine())</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>komunikat</ID>
          <ToolTip>komunikat</ToolTip>
          <Default>Podaj liczbę</Default>
        </Literal>
        <Literal>
          <ID>n</ID>
          <ToolTip>n</ToolTip>
          <Default>n</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method body" Delimiter="$"><![CDATA[Console.Write("$komunikat$: ");
int $n$ = int.Parse(Console.ReadLine());]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
