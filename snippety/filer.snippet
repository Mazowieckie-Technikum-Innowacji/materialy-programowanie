<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Wczytaj linie z pliku</Title>
      <Shortcut>filer</Shortcut>
      <Description>File.ReadAllLines i foreach</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Imports>
        <Import><Namespace>System.IO</Namespace></Import>
      </Imports>
      <Declarations>
        <Literal>
          <ID>linie</ID>
          <ToolTip>linie</ToolTip>
          <Default>linie</Default>
        </Literal>
        <Literal>
          <ID>plik</ID>
          <ToolTip>plik</ToolTip>
          <Default>dane.txt</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method body" Delimiter="$"><![CDATA[string[] $linie$ = File.ReadAllLines("$plik$");
foreach (string linia in $linie$)
{
    $end$
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
