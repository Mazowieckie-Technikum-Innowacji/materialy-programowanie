<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>throw ArgumentOutOfRangeException</Title>
      <Shortcut>thrr</Shortcut>
      <Description>Wyjatek dla wartosci poza zakresem</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>param</ID>
          <ToolTip>param</ToolTip>
          <Default>parametr</Default>
        </Literal>
        <Literal>
          <ID>komunikat</ID>
          <ToolTip>komunikat</ToolTip>
          <Default>Wartość poza zakresem.</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method body" Delimiter="$"><![CDATA[throw new ArgumentOutOfRangeException(nameof($param$), "$komunikat$");]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
