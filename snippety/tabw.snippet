<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Wypisz tablice</Title>
      <Shortcut>tabw</Shortcut>
      <Description>Petla for wypisujaca indeks i wartosc</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>t</ID>
          <ToolTip>t</ToolTip>
          <Default>tab</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method body" Delimiter="$"><![CDATA[for (int i = 0; i < $t$.Length; i++)
{
    Console.WriteLine($$"{i}: {$t$[i]}");
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
