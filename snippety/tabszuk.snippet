<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Szukaj w tablicy</Title>
      <Shortcut>tabszuk</Shortcut>
      <Description>Indeks pierwszego wystapienia (-1 gdy brak)</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>t</ID>
          <ToolTip>t</ToolTip>
          <Default>tab</Default>
        </Literal>
        <Literal>
          <ID>indeks</ID>
          <ToolTip>indeks</ToolTip>
          <Default>indeks</Default>
        </Literal>
        <Literal>
          <ID>szukana</ID>
          <ToolTip>szukana</ToolTip>
          <Default>5</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method body" Delimiter="$"><![CDATA[int $indeks$ = -1;
for (int i = 0; i < $t$.Length; i++)
{
    if ($t$[i] == $szukana$)
    {
        $indeks$ = i;
        break;
    }
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
