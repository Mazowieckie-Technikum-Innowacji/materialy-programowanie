<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Klasa abstrakcyjna</Title>
      <Shortcut>abskl</Shortcut>
      <Description>Klasa abstrakcyjna z metoda abstrakcyjna</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>Klasa</ID>
          <ToolTip>Klasa</ToolTip>
          <Default>Ksztalt</Default>
        </Literal>
        <Literal>
          <ID>typ</ID>
          <ToolTip>typ</ToolTip>
          <Default>double</Default>
        </Literal>
        <Literal>
          <ID>Metoda</ID>
          <ToolTip>Metoda</ToolTip>
          <Default>Pole</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="type decl" Delimiter="$"><![CDATA[public abstract class $Klasa$
{
    public abstract $typ$ $Metoda$();
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
