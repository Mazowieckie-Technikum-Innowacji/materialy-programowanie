<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Czy liczba pierwsza</Title>
      <Shortcut>pierw</Shortcut>
      <Description>Test pierwszosci</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>nazwa</ID>
          <ToolTip>nazwa</ToolTip>
          <Default>CzyPierwsza</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method decl" Delimiter="$"><![CDATA[public static bool $nazwa$(int n)
{
    if (n < 2) return false;
    for (int i = 2; (long)i * i <= n; i++)
    {
        if (n % i == 0) return false;
    }
    return true;
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
