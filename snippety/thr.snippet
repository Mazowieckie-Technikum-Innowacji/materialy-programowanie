<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>throw ArgumentException</Title>
      <Shortcut>thr</Shortcut>
      <Description>Zgloszenie wyjatku</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>komunikat</ID>
          <ToolTip>komunikat</ToolTip>
          <Default>Niepoprawna wartość.</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method body" Delimiter="$"><![CDATA[throw new ArgumentException("$komunikat$");]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
