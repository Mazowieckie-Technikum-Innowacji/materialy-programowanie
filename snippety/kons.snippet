<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Konstruktor z parametrem</Title>
      <Shortcut>kons</Shortcut>
      <Description>Konstruktor przypisujacy parametr do pola</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>Klasa</ID>
          <ToolTip>Klasa</ToolTip>
          <Default>Klasa</Default>
        </Literal>
        <Literal>
          <ID>typ</ID>
          <ToolTip>typ</ToolTip>
          <Default>int</Default>
        </Literal>
        <Literal>
          <ID>param</ID>
          <ToolTip>param</ToolTip>
          <Default>pole</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method decl" Delimiter="$"><![CDATA[public $Klasa$($typ$ $param$)
{
    this.$param$ = $param$;
    $end$
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
