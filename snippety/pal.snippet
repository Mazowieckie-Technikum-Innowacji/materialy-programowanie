<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Czy palindrom</Title>
      <Shortcut>pal</Shortcut>
      <Description>Sprawdzenie palindromu w stringu</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>nazwa</ID>
          <ToolTip>nazwa</ToolTip>
          <Default>CzyPalindrom</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method decl" Delimiter="$"><![CDATA[public static bool $nazwa$(string tekst)
{
    for (int i = 0; i < tekst.Length / 2; i++)
    {
        if (tekst[i] != tekst[tekst.Length - 1 - i]) return false;
    }
    return true;
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
