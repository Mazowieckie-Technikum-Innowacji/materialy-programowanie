<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>try / catch</Title>
      <Shortcut>trc</Shortcut>
      <Description>Obsluga FormatException i ArgumentException</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType><SnippetType>SurroundsWith</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="CSharp" Kind="method body" Delimiter="$"><![CDATA[try
{
    $selected$ $end$
}
catch (FormatException)
{
    Console.WriteLine("Niepoprawny format danych.");
}
catch (ArgumentException ex)
{
    Console.WriteLine(ex.Message);
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
