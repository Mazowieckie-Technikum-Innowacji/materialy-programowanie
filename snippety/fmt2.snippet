<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Format 2 miejsca po przecinku</Title>
      <Shortcut>fmt2</Shortcut>
      <Description>ToString z kropka jako separatorem</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Imports>
        <Import><Namespace>System.Globalization</Namespace></Import>
      </Imports>
      <Declarations>
        <Literal>
          <ID>wynik</ID>
          <ToolTip>wynik</ToolTip>
          <Default>tekst</Default>
        </Literal>
        <Literal>
          <ID>liczba</ID>
          <ToolTip>liczba</ToolTip>
          <Default>wartosc</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method body" Delimiter="$"><![CDATA[string $wynik$ = $liczba$.ToString("0.00", CultureInfo.InvariantCulture);]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
