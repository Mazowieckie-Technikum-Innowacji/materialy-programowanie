<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Lista List&lt;T&gt;</Title>
      <Shortcut>lst</Shortcut>
      <Description>Utworzenie listy i dodanie elementu</Description>
      <Author>INF.04</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Imports>
        <Import><Namespace>System.Collections.Generic</Namespace></Import>
      </Imports>
      <Declarations>
        <Literal>
          <ID>typ</ID>
          <ToolTip>typ</ToolTip>
          <Default>int</Default>
        </Literal>
        <Literal>
          <ID>lista</ID>
          <ToolTip>lista</ToolTip>
          <Default>lista</Default>
        </Literal>
        <Literal>
          <ID>wartosc</ID>
          <ToolTip>wartosc</ToolTip>
          <Default>1</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp" Kind="method body" Delimiter="$"><![CDATA[List<$typ$> $lista$ = new List<$typ$>();
$lista$.Add($wartosc$);]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
